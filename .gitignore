# --- Unreal Engine 기본 제외 항목 ---
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
.vscode/
*.sln
*.vcxproj
*.filters
*.user
*.db
*.opendb

# --- 에셋 파일 제외 (LFS 용량 문제 해결) ---
# Content 폴더 내의 무거운 파일들을 제외합니다.
Content/

# --- 필수 설정 파일 (반드시 포함해야 함) ---
# 위에서 Content를 지웠으므로, 설정 파일들은 제외되지 않도록 유지합니다.
!Config/
Config/Template/

# --- 소스 코드 (반드시 포함) ---
!Source/

# --- 기타 ---
*.exe
*.dll
*.log
.DS_Store